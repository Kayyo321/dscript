log('== loop finally semantics ==');

let w = 0;
while w < 2 do {
    w = w + 1;
    log('while tick');
    log(w);
} finally {
    log('while finally');
}

let i = 0;
for i < 3 do {
    i = i + 1;
} finally {
    log('for finally');
}
log('for runs:');
log(i);

let d = 0;
do {
    d = d + 1;
} while d < 2; finally {
    log('do-while finally');
}
log('do runs:');
log(d);

let while_zero = 0;
while while_zero > 0 do {
    while_zero = while_zero + 1;
} finally {
    while_zero = 99;
    log('while zero finally should NOT print');
}
log('while_zero marker:');
log(while_zero);

let for_zero = 0;
for for_zero < 0 do {
    for_zero = for_zero + 1;
} finally {
    for_zero = 99;
    log('for zero finally should NOT print');
}
log('for_zero marker:');
log(for_zero);
