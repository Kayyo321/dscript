fn fib(n) {
    if n <= 1 then 
        return n;

    let a, b = 0, 1;
    for (let i = 2; i < n + 1; ++i) do {
        a, b = b, a+b;
    }

    return b
}

fn main() {
    let n = 100;
    let result = fib(n);
    
    let out = "f(";
    out = append(out, to_string(n));
    out = append(out, ") = ");
    out = append(out, to_string(result));
    
    log(out);
}