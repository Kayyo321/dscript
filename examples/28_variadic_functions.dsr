fn format(fmt, ...args) {
    let out = "";

    let args_idx = 0;
    for (let i = 0; i < length(fmt); ++i) do {
        if fmt[i] == '$' then {
            out = append(out, to_string(args[args_idx++]));
        } else {
            out = append(out, fmt[i]);
        }
    }

    return out;
}

fn main() {
    log('== variadic functions ==');

    let fmt = format("hi $, you're $ years old", 'sully', 17);
    log(fmt);
}
