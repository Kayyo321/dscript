fn main() {
    log('Hello, World!');

    let i = 10;
    funny(i);
}

fn funny(i) {
    log('This is the block-literal!');
    log(i);
}

def dummy; "simple custom keyword, no logic attached"

def smarty(cond) {
    if cond then {
        log('true!');
    } else {
        log('*loud incorrect buzzer*!');
    }
}